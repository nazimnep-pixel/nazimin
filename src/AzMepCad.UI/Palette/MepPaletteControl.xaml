<UserControl x:Class="AzMepCad.UI.Palette.MepPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             MinHeight="400">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText"
               FontSize="16"
               FontWeight="SemiBold"
               Margin="0,0,0,8"/>
    <TabControl Grid.Row="1">
      <TabItem x:Name="RoutingTab"/>
      <TabItem x:Name="CatalogTab"/>
      <TabItem x:Name="BoqTab"/>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock x:Name="DiameterLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox Width="80" Text="110"/>
      <Button x:Name="RouteButton" Margin="8,0,0,0" Padding="12,4"/>
    </StackPanel>
    <TextBlock Grid.Row="2"
               x:Name="StatusText"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Foreground="Gray"/>
  </Grid>
</UserControl>
